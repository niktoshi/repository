<!DOCTYPE html>
<html lang="ru">
<head><meta charset="UTF-8"><title>Админ-панель — СтройМаркет</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
<header><a href="/" style="font-weight:bold">СтройМаркет</a><nav><a href="/catalog">Каталог</a><a href="/logout">Выйти</a></nav></header>
<main class="container">
<h1>Админ-панель</h1>
<p>Товаров: <b><%= products.length %></b> | Заказов: <b><%= orders.length %></b> | Низкий остаток (&lt; 5): <b><%= products.filter(p => p.stock < 5).length %></b></p>
<h2>Добавить товар</h2>
<form method="POST" action="/admin/products" class="card" style="display:grid;gap:8px;max-width:500px">
<input name="name" placeholder="Название" required><input name="description" placeholder="Описание"><input name="price" type="number" step="0.01" min="0" placeholder="Цена" required><input name="stock" type="number" min="0" placeholder="Остаток на складе" required>
<select name="category_id"><% categories.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select>
<button class="btn" type="submit">Добавить</button>
</form>
<h2>Склад</h2>
<% products.forEach(p => { %><div class="card" style="margin-bottom:8px;display:flex;justify-content:space-between;gap:12px"><span><b><%= p.name %></b> — <%= p.price %> ₽, остаток: <b style="color:<%= p.stock < 5 ? 'var(--burgundy)' : 'inherit' %>"><%= p.stock %></b></span><span><form method="POST" action="/admin/products/<%= p.id %>/stock" style="display:inline"><input type="number" name="stock" value="<%= p.stock %>" min="0" style="width:70px"><button type="submit">Обновить</button></form> <form method="POST" action="/admin/products/<%= p.id %>/delete" style="display:inline" onsubmit="return confirm('Удалить товар?')"><button type="submit">Удалить</button></form></span></div><% }) %>
<h2>Заказы</h2>
<% if (typeof error !== 'undefined' && error) { %><div class="auth-error" style="text-align:left;margin:0 0 14px"><%= error %></div><% } %>
<% if (typeof success !== 'undefined' && success) { %><div style="background:#eaf7ee;border:1px solid #bfe6c9;color:#1a7a2e;padding:12px 14px;border-radius:10px;margin:0 0 14px"><%= success %></div><% } %>
<p style="color:#555">При переводе заказа в статус <b>completed (Выполнен)</b> количество товаров автоматически уменьшится на складе. Повторное завершение остаток второй раз не спишет.</p>
<% orders.forEach(o => { %><div class="card" style="margin-bottom:8px">Заказ #<%= o.id %> — <%= o.user_name %> (<%= o.user_email %>) — <b><%= o.total %> ₽</b> — статус: <b><%= o.status %></b> — <%= o.stock_deducted ? 'остаток списан со склада' : 'остаток ещё не списан' %> — <%= o.created_at %><form method="POST" action="/admin/orders/<%= o.id %>/status" style="display:inline;margin-left:8px"><select name="status"><option value="new" <%= o.status==='new'?'selected':'' %>>Новый</option><option value="processing" <%= o.status==='processing'?'selected':'' %>>В обработке</option><option value="completed" <%= o.status==='completed'?'selected':'' %>>Выполнен</option><option value="cancelled" <%= o.status==='cancelled'?'selected':'' %>>Отменён</option></select><button type="submit">Сохранить</button></form></div><% }) %>
</main>
</body></html>
