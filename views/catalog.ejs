<!DOCTYPE html>
<html lang="ru">
<head><meta charset="UTF-8"><title>Каталог — СтройМаркет</title><link rel="stylesheet" href="/css/style.css"></head>
<body>
<header><a href="/" style="font-weight:bold">СтройМаркет</a><nav><a href="/">Главная</a><a href="/cart">Корзина</a><% if (user) { %><a href="/profile">Профиль</a><a href="/orders">Мои заказы</a><a href="/logout">Выйти</a><% } else { %><a href="/login">Войти</a><% } %></nav></header>
<main class="container">
<h1>Каталог товаров</h1>
<p style="color:#555">Фото, цена и реальный остаток на складе — для каждого товара.</p>
<form method="GET" action="/catalog" style="display:flex;gap:8px;margin-bottom:20px;flex-wrap:wrap">
<input name="search" placeholder="Поиск..." value="<%= typeof search !== 'undefined' ? search : '' %>" style="flex:1;min-width:180px;padding:10px">
<select name="category" style="padding:10px"><option value="">Все категории</option><% categories.forEach(c => { %><option value="<%= c.id %>" <%= String(categoryId) === String(c.id) ? 'selected' : '' %>><%= c.name %></option><% }) %></select>
<button class="btn" type="submit">Найти</button>
</form>
<div class="products-grid">
<% products.forEach(p => { %>
<article class="product-card">
<div class="product-image"><% if (p.image_url) { %><img src="<%= p.image_url %>" alt="<%= p.name %>"><% } else { %><span class="product-image-placeholder">🏗️<small>Фото товара</small></span><% } %></div>
<div class="product-body">
<span style="font-size:13px;color:#777"><%= p.category_name || 'Без категории' %></span>
<h3><a href="/product/<%= p.id %>"><%= p.name %></a></h3>
<p style="margin:0;color:#555;font-size:14px"><%= p.description ? p.description.substring(0, 90) + (p.description.length > 90 ? '…' : '') : 'Описание пока не добавлено.' %></p>
<p class="price" style="margin:8px 0 0"><%= p.price %> ₽</p>
<p class="stock" style="margin:0"><% if (p.stock > 5) { %><span class="stock-ok">● В наличии: <%= p.stock %></span><% } else if (p.stock > 0) { %><span class="stock-low">● Осталось мало: <%= p.stock %></span><% } else { %><span class="stock-out">● Нет в наличии</span><% } %></p>
<div style="margin-top:auto;display:flex;gap:8px;flex-wrap:wrap"><a class="btn" style="flex:1;text-align:center;background:var(--black)" href="/product/<%= p.id %>">Подробнее</a><% if (p.stock > 0) { %><form method="POST" action="/cart/add" style="flex:1"><input type="hidden" name="product_id" value="<%= p.id %>"><input type="hidden" name="quantity" value="1"><input type="hidden" name="return_to" value="<%= typeof currentUrl !== 'undefined' ? currentUrl : '/catalog' %>"><button class="btn" type="submit" style="width:100%">🛒 В корзину</button></form><% } else { %><button class="btn" type="button" disabled style="flex:1">Нет в наличии</button><% } %></div>
</div>
</article>
<% }) %>
</div>
<% if (!products.length) { %><p>Ничего не найдено. Попробуйте другой запрос или категорию.</p><% } %>
</main>
<footer>СтройМаркет © 2026</footer>
</body></html>
